# =============================================================================
# NOTE: This .env file is INTENTIONALLY tracked in git.
# Secrets (API keys, credentials) are stored in GCP Secret Manager, not here.
# This file only contains non-sensitive configuration values.
# =============================================================================

# Environment Settings
# Development mode: Auto-detects credentials, enables sampling
# Production mode: Uses VM service account, disables sampling
ENVIRONMENT=development

# Shard-based API key rotation (SHARD_INDEX=0 for local; deployment injects 0..N)
SHARD_INDEX=0
enable_ccxt_integration=true
enable_metadata_caching=true
cache_ttl_hours=24
max_batch_size=1000
lookback_days=0

# =============================================================================
# CLOUD PROVIDER SELECTION
# Set to "gcp" for Google Cloud Platform or "aws" for Amazon Web Services
# =============================================================================
CLOUD_PROVIDER=gcp

# Optional: Override provider for specific services (hybrid cloud)
# SECRETS_CLOUD_PROVIDER=gcp  # Keep secrets on GCP even when using AWS
# STORAGE_CLOUD_PROVIDER=aws  # Use S3 even when main provider is GCP

# =============================================================================
# GCP Configuration (when CLOUD_PROVIDER=gcp)
# =============================================================================
# Credentials path (relative to .env file location or absolute path)
# unified-cloud-services will auto-detect in development mode if not set
GOOGLE_APPLICATION_CREDENTIALS=central-element-323112-e35fb0ddafe2.json
GCP_PROJECT_ID=central-element-323112

# GCS Location Configuration (matches market-tick-data-handler)
GCS_REGION=asia-northeast1-c
GCS_LOCATION=asia-northeast1

# Instruments Service Configuration
# Each domain has its own bucket and dataset (instruments domain)
# Category-specific buckets for independent batch processing
INSTRUMENTS_GCS_BUCKET_CEFI=instruments-store-cefi-central-element-323112
INSTRUMENTS_GCS_BUCKET_TRADFI=instruments-store-tradfi-central-element-323112
INSTRUMENTS_GCS_BUCKET_DEFI=instruments-store-defi-central-element-323112

# Category-specific test buckets (for integration/E2E tests)
INSTRUMENTS_GCS_BUCKET_CEFI_TEST=instruments-store-test-cefi-central-element-323112
INSTRUMENTS_GCS_BUCKET_TRADFI_TEST=instruments-store-test-tradfi-central-element-323112
INSTRUMENTS_GCS_BUCKET_DEFI_TEST=instruments-store-test-defi-central-element-323112

INSTRUMENTS_BIGQUERY_DATASET=instruments
BIGQUERY_LOCATION=asia-northeast1


# CSV Sampling Configuration (only used in development mode)
ENABLE_CSV_SAMPLING=true
CSV_SAMPLE_SIZE=20000
CSV_SAMPLE_DIR=./data/samples

# API Key Configuration (Secret Manager)
# All API keys are stored in GCP Secret Manager for security
# The service automatically retrieves keys using secret names below
# NEVER commit actual API keys to this file

# Secret Manager secret names (keys stored in GCP Secret Manager)
# Note: Actual API keys are stored in GCP Secret Manager, not in .env files
# To add/update secrets, use: gcloud secrets create/update SECRET_NAME --data-file=-
# Rotation: Databento 20 keys (databento-api-key-1..20), Graph 9 keys (thegraph-api-key, thegraph-api-key-2..9)
# Both use SHARD_INDEX from env (injected by deployment; 0 for local = first key)
TARDIS_SECRET_NAME=tardis-api-key-full
TARDIS_FULL_SECRET_NAME=tardis-api-key-full
DATABENTO_SECRET_NAME=databento-api-key
DATABENTO_BATCH_REGISTRY_BUCKET=databento-batch-registry-asia-central-element-323112
AAVESCAN_SECRET_NAME=aavescan-api-key
ALCHEMY_SECRET_NAME=alchemy-api-key
GRAPH_SECRET_NAME=thegraph-api-key


# DeFi MVP tokens (comma-separated list, optional override)
DEFI_MVP_TOKENS=ETH,WETH,BTC,WBTC,USDT,USDC,DAI,weETH,WSTETH,eETH,USDE,SUSDE
