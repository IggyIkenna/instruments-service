# =============================================================================
# Instruments Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All fields are optional with sensible defaults unless marked REQUIRED.
#
# For multi-cloud support, this config works on both GCP and AWS.
# Set CLOUD_PROVIDER to switch between providers.
# =============================================================================

# -----------------------------------------------------------------------------
# CLOUD PROVIDER (GCP or AWS)
# -----------------------------------------------------------------------------
# REQUIRED: Specify which cloud provider to use
# Options: "gcp" or "aws"
CLOUD_PROVIDER=gcp

# Optional: Override provider for specific services (hybrid cloud)
# SECRETS_CLOUD_PROVIDER=gcp  # Keep secrets on GCP even when using AWS
# STORAGE_CLOUD_PROVIDER=aws  # Use S3 even when main provider is GCP

# -----------------------------------------------------------------------------
# GCP Configuration (when CLOUD_PROVIDER=gcp)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=central-element-323112
GCS_REGION=asia-northeast1-c
BIGQUERY_LOCATION=asia-northeast1

# GCP Credentials
# Path to service account JSON file (relative to this file or absolute path)
# Leave empty if using gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Or use Application Default Credentials (gcloud auth application-default login)

# -----------------------------------------------------------------------------
# AWS Configuration (when CLOUD_PROVIDER=aws)
# -----------------------------------------------------------------------------
AWS_PROJECT_ID=central-element-323112-aws
AWS_REGION=us-east-1
# AWS_PROFILE=default  # Optional: Use named profile instead of env credentials

# AWS Athena (equivalent to BigQuery)
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://unified-trading-athena-results-${AWS_PROJECT_ID}/

# -----------------------------------------------------------------------------
# INSTRUMENTS-SPECIFIC GCS/S3 BUCKETS
# -----------------------------------------------------------------------------
# Bucket templates use {project_id} placeholder - automatically filled from GCP_PROJECT_ID or AWS_PROJECT_ID
# Format: instruments-store-{category}-{project_id}

# Category-specific buckets (recommended for independent batch processing)
INSTRUMENTS_GCS_BUCKET_CEFI=instruments-store-cefi-{project_id}
INSTRUMENTS_GCS_BUCKET_TRADFI=instruments-store-tradfi-{project_id}
INSTRUMENTS_GCS_BUCKET_DEFI=instruments-store-defi-{project_id}

# Test buckets (for quality gates)
INSTRUMENTS_GCS_BUCKET_TEST=instruments-store-test-{project_id}

# -----------------------------------------------------------------------------
# BIGQUERY/ATHENA CONFIGURATION
# -----------------------------------------------------------------------------
BIGQUERY_DATASET=instruments_data
BIGQUERY_LOCATION=asia-northeast1

# -----------------------------------------------------------------------------
# ENVIRONMENT & LOGGING
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SECRET MANAGER CONFIGURATION
# -----------------------------------------------------------------------------
# Secret names for API keys (stored in GCP Secret Manager or AWS Secrets Manager)
# TARDIS_SECRET_NAME=tardis-api-key
# DATABENTO_SECRET_NAME=databento-api-key
# ALCHEMY_SECRET_NAME=alchemy-api-key
# AAVESCAN_SECRET_NAME=aavescan-api-key

# -----------------------------------------------------------------------------
# TEST CONFIGURATION
# -----------------------------------------------------------------------------
# Enable mock mode for cloud operations (CI/CD testing)
CLOUD_MOCK_MODE=false

# Skip GCS FUSE availability check on import
UCS_SKIP_GCSFUSE_CHECK=1
