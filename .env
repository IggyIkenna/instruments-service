# GCP Configuration
# Credentials path (relative to .env file location or absolute path)
# unified-cloud-services will auto-detect in development mode if not set
GOOGLE_APPLICATION_CREDENTIALS=../central-element-323112-e35fb0ddafe2.json
GCP_PROJECT_ID=central-element-323112

# GCS Location Configuration (matches market-tick-data-handler)
GCS_REGION=asia-northeast1-c
GCS_LOCATION=asia-northeast1

# Instruments Service Configuration
# Each domain has its own bucket and dataset (instruments domain)
INSTRUMENTS_GCS_BUCKET=instruments-store-central-element-323112
INSTRUMENTS_GCS_BUCKET_TEST=instruments-store-test-central-element-323112
INSTRUMENTS_BIGQUERY_DATASET=instruments
BIGQUERY_LOCATION=asia-northeast1

# Environment Settings
# Development mode: Auto-detects credentials, enables sampling
# Production mode: Uses VM service account, disables sampling
ENVIRONMENT=development

# CSV Sampling Configuration (only used in development mode)
ENABLE_CSV_SAMPLING=true
CSV_SAMPLE_SIZE=20000
CSV_SAMPLE_DIR=./data/samples

# API Key Configuration (Secret Manager)
# All API keys are stored in GCP Secret Manager for security
# The service automatically retrieves keys using secret names below
# NEVER commit actual API keys to this file

# Secret Manager secret names (keys stored in GCP Secret Manager)
TARDIS_SECRET_NAME=tardis-api-key
DATABENTO_SECRET_NAME=databento-api-key
AAVESCAN_SECRET_NAME=aavescan-api-key
ALCHEMY_SECRET_NAME=alchemy-api-key

# Note: Actual API keys are stored in GCP Secret Manager, not in .env files
# To add/update secrets, use: gcloud secrets create/update SECRET_NAME --data-file=-
