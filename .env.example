# =============================================================================
# Copy to .env and fill in values. Never commit .env to git.
# Local dev: Use ADC (gcloud auth application-default login) - no key file needed.
# =============================================================================

# Environment Settings
ENVIRONMENT=development
enable_ccxt_integration=true
enable_metadata_caching=true
cache_ttl_hours=24
max_batch_size=1000
lookback_days=0

# =============================================================================
# CLOUD PROVIDER SELECTION
# =============================================================================
CLOUD_PROVIDER=gcp

# =============================================================================
# GCP Configuration (when CLOUD_PROVIDER=gcp)
# =============================================================================
GCP_PROJECT_ID=your-gcp-project-id

# GCS Location Configuration
GCS_REGION=asia-northeast1-c
GCS_LOCATION=asia-northeast1

# Instruments Service Configuration - Category-specific buckets
INSTRUMENTS_GCS_BUCKET_CEFI=instruments-store-cefi-your-gcp-project-id
INSTRUMENTS_GCS_BUCKET_TRADFI=instruments-store-tradfi-your-gcp-project-id
INSTRUMENTS_GCS_BUCKET_DEFI=instruments-store-defi-your-gcp-project-id

# Category-specific test buckets (for integration/E2E tests)
INSTRUMENTS_GCS_BUCKET_CEFI_TEST=instruments-store-test-cefi-your-gcp-project-id
INSTRUMENTS_GCS_BUCKET_TRADFI_TEST=instruments-store-test-tradfi-your-gcp-project-id
INSTRUMENTS_GCS_BUCKET_DEFI_TEST=instruments-store-test-defi-your-gcp-project-id

INSTRUMENTS_BIGQUERY_DATASET=instruments
BIGQUERY_LOCATION=asia-northeast1

# CSV Sampling Configuration (development mode only)
ENABLE_CSV_SAMPLING=true
CSV_SAMPLE_SIZE=20000
CSV_SAMPLE_DIR=./data/samples

# API Key Configuration - Secret Manager secret names (keys stored in GCP Secret Manager)
TARDIS_SECRET_NAME=tardis-api-key-full
TARDIS_FULL_SECRET_NAME=tardis-api-key-full
DATABENTO_SECRET_NAME=databento-api-key
DATABENTO_BATCH_REGISTRY_BUCKET=databento-batch-registry-asia-your-gcp-project-id
AAVESCAN_SECRET_NAME=aavescan-api-key
ALCHEMY_SECRET_NAME=alchemy-api-key
GRAPH_SECRET_NAME=graph-api-key

# The Graph URLs (Studio endpoints for testing, rate-limited)
UNISWAP_V3_GRAPH_URL=https://api.studio.thegraph.com/query/50688/uniswap-v3/version/latest
UNISWAP_V3_GRAPH_ARB_URL=https://api.studio.thegraph.com/query/50688/uniswap-v3-arbitrum/version/latest
UNISWAP_V3_GRAPH_BASE_URL=https://api.studio.thegraph.com/query/50688/uniswap-v3-base/version/latest
ENVIO_API_URL=https://api.envio.dev/v1/prices
DEFI_MVP_TOKENS=ETH,WETH,BTC,WBTC,USDT,USDC,DAI,weETH,WSTETH,eETH,USDE,SUSDE

# GitHub Configuration (for CI and local path dependency installs)
# GH_PAT loaded from GCP Secret Manager in cloudbuild.yaml
# For local dev: export GH_PAT=your-token or add to .env (not committed)
GH_PAT=
